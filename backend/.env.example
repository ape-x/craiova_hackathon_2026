# Copy to .env in this backend directory. Never commit .env.
ENVIRONMENT=development
DATABASE_PATH=data/recovery.sqlite3
PUBLIC_BASE_URL=http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Run: python3 backend/scripts/configure_operator.py --generate
OPERATOR_USERNAME=
OPERATOR_PASSWORD_HASH=
# Optional API bearer token; keep empty for password-only access.
OPERATOR_TOKEN=
HOLD_TTL_SECONDS=600
SESSION_TTL_SECONDS=28800

# Account credentials stay on the server. No key means an explicitly local solver.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_DECISION_MODEL=gpt-6-luna
OPENAI_VOICE_MODEL=gpt-live-1
OPENAI_SERVICE_TIER=ultrafast
REQUEST_TIMEOUT_SECONDS=45
VOICE_MAX_SECONDS=180

# API subscription, not the consumer Flightradar24 subscription.
# The feed stays paused until an operator starts it in Connections.
FR24_API_KEY=
FR24_ENVIRONMENT=live
# north,south,west,east; includes the CRA, OTP and SBZ scenario region.
FR24_BOUNDS=46.0,43.8,23.0,26.5
FR24_RESULT_LIMIT=5
FLIGHT_POLL_SECONDS=30
FR24_MAX_REQUESTS=80
FR24_MAX_CREDITS=4000
# Technical cache policy, not a guarantee of compliance with a data license.
OBSERVATION_RETENTION_SECONDS=3600

# This is a public browser key. Restrict it by origin and Maps JavaScript API.
GOOGLE_MAPS_API_KEY=

# Optional private server key, separate from the public browser key above.
# Enable Places API (New) and Routes API. Without it, reference lookups use OSM/OSRM.
GOOGLE_MAPS_SERVER_API_KEY=

# Optional Booking.com Demand API partner access for live room offers.
BOOKING_DEMAND_API_TOKEN=
BOOKING_AFFILIATE_ID=
BOOKING_BOOKER_COUNTRY=ro

# Hotel rate supplier: auto prefers a configured LiteAPI key, then Booking.
HOTEL_OFFERS_PROVIDER=auto
# Nuitee / LiteAPI: a sandbox key never enables live price display.
LITEAPI_API_KEY=
LITEAPI_ENVIRONMENT=sandbox
LITEAPI_GUEST_NATIONALITY=RO

# Low-volume local evaluation endpoints. Use operated services for production.
REAL_DATA_OVERPASS_URL=https://overpass-api.de/api/interpreter
REAL_DATA_OSRM_URL=https://router.project-osrm.org

# Dated flight fares: account activation and live Duffel token required.
# Searching creates an offer request only; this app never creates an order.
DUFFEL_ACCESS_TOKEN=
DUFFEL_ENVIRONMENT=sandbox

# Dated coach fares: production partner key, coverage, and Offers flow activation
# must be provided by Distribusion. Search does not reserve any seats.
DISTRIBUSION_API_KEY=
DISTRIBUSION_ENVIRONMENT=sandbox
DISTRIBUSION_OFFERS_ENABLED=false

# Registered Airport Pickups London key. Server-side transfer quotes only;
# prices are GBP per vehicle. This application does not book or dispatch drivers.
APL_API_KEY=

# Real resources by default; test passengers are generated only on explicit request.
OPERATION_MODE=live

# auto prefers production Nuitee (existing LiteAPI key), then Duffel.
# Choose duffel explicitly to retain the LiteAPI key for hotel searches.
# A selected provider failure never triggers a fallback search.
FLIGHT_OFFERS_PROVIDER=auto
