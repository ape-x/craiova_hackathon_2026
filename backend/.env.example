# Copy to .env in this backend directory. Never commit .env.
ENVIRONMENT=development
DATABASE_PATH=data/recovery.sqlite3
PUBLIC_BASE_URL=http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPERATOR_TOKEN=
HOLD_TTL_SECONDS=600
SESSION_TTL_SECONDS=28800

# Account credentials stay on the server. No key means an explicitly local solver.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_DECISION_MODEL=gpt-6-luna
OPENAI_VOICE_MODEL=gpt-live-1
OPENAI_SERVICE_TIER=ultrafast
REQUEST_TIMEOUT_SECONDS=45
VOICE_MAX_SECONDS=180

# API subscription, not the consumer Flightradar24 subscription.
# The feed stays paused until an operator starts it in Connections.
FR24_API_KEY=
FR24_ENVIRONMENT=live
# north,south,west,east; includes the CRA, OTP and SBZ scenario region.
FR24_BOUNDS=46.0,43.8,23.0,26.5
FR24_RESULT_LIMIT=5
FLIGHT_POLL_SECONDS=30
FR24_MAX_REQUESTS=80
FR24_MAX_CREDITS=4000
# Technical cache policy, not a guarantee of compliance with a data license.
OBSERVATION_RETENTION_SECONDS=3600

# This is a public browser key. Restrict it by origin and Maps JavaScript API.
GOOGLE_MAPS_API_KEY=
