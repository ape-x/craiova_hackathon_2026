# Airport Recovery Live - real-data provider credentials
# Share this EMPTY template with the person provisioning provider access.
# Return completed credentials through a private channel; never commit them.
# Merge completed values into backend/.env without overwriting existing settings.
# This is a credential request, not a complete deployment configuration.
# Blank means unavailable. Do not insert sample keys or sandbox data as live data.

# -----------------------------------------------------------------------------
# ALREADY READ BY THE APPLICATION
# -----------------------------------------------------------------------------

# Public browser key: Maps JavaScript API, restricted to the application's origins.
# This key is intentionally exposed to the browser. Never put a server key here.
GOOGLE_MAPS_API_KEY=

# Flightradar24 API subscription, separate from a consumer website subscription.
# Aircraft observations only: no ticket prices, bookable seats or hotel inventory.
# The feed starts only when the operator enables it in Connections.
# https://fr24api.flightradar24.com/docs/authentication
FR24_API_KEY=
FR24_ENVIRONMENT=live

# -----------------------------------------------------------------------------
# OPTIONAL REAL-DATA INTEGRATIONS - SUPPORTED BY THE APPLICATION
# After changing backend/.env, restart the backend or recreate its container.
# Use the explicit Real hotels & routes search to contact these providers.
# -----------------------------------------------------------------------------

# Private backend key, SEPARATE from GOOGLE_MAPS_API_KEY above.
# Enable billing, Places API (New) and Routes API in the Google Cloud project.
# Restrict this key to these APIs and the backend's outgoing IPs where applicable.
# Places: hotel identity, address, coordinates and contact information.
# Routes: road distance and estimated travel time; no coach/rail seat inventory.
# https://developers.google.com/maps/documentation/places/web-service/get-api-key
# https://developers.google.com/maps/documentation/routes/get-api-key
GOOGLE_MAPS_SERVER_API_KEY=

# Booking.com Demand API: production accommodation search and availability access.
# Requires an authorised Managed Affiliate Partner account and agreement.
# Request API access, not a regular traveller account or accommodation-owner login.
# API token -> Authorization: Bearer; affiliate ID -> X-Affiliate-Id.
# https://developers.booking.com/demand/docs/getting-started/prerequisites
# https://developers.booking.com/demand/docs/development-guide/authentication
BOOKING_DEMAND_API_TOKEN=
BOOKING_AFFILIATE_ID=
BOOKING_BOOKER_COUNTRY=ro

# Alternative hotel-rate supplier: Nuitee Connect / LiteAPI.
# Free account provides sandbox access. Production access has separate requirements.
# Only an authorised prod_ key with LITEAPI_ENVIRONMENT=live can return live offers.
# No payment or booking is performed by this application's adapter.
# https://docs.liteapi.travel/docs/getting-a-sandbox-key
HOTEL_OFFERS_PROVIDER=auto
LITEAPI_API_KEY=
LITEAPI_ENVIRONMENT=sandbox
LITEAPI_GUEST_NATIONALITY=RO

# Used when no Google server key is configured. Public hosts are for low-volume
# local evaluation. Configure operated services before production use.
REAL_DATA_OVERPASS_URL=https://overpass-api.de/api/interpreter
REAL_DATA_OSRM_URL=https://router.project-osrm.org

# Ground transport pricing and available seats require a selected operator's API.
# Supply that operator's API documentation and authorised credentials separately;
# no generic transport key or authentication scheme has been invented here.
# Real flight ticket offers likewise require a separate flight-shopping provider.
# None of these credentials alone authorises bookings or payments.

# Dated flight fares: account activation and live Duffel token required.
# Searching creates an offer request only; this app never creates an order.
DUFFEL_ACCESS_TOKEN=
DUFFEL_ENVIRONMENT=sandbox

# Dated coach fares: production partner key, coverage, and Offers flow activation
# must be provided by Distribusion. Search does not reserve any seats.
DISTRIBUSION_API_KEY=
DISTRIBUSION_ENVIRONMENT=sandbox
DISTRIBUSION_OFFERS_ENABLED=false

# Real resources by default; test passengers are generated only on explicit request.
OPERATION_MODE=live

# auto prefers production Nuitee (existing LiteAPI key), then Duffel.
# Choose duffel explicitly to retain the LiteAPI key for hotel searches.
# A selected provider failure never triggers a fallback search.
FLIGHT_OFFERS_PROVIDER=auto
