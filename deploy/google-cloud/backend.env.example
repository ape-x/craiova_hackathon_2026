# PRIVATE RUNTIME FILE: copy outside the checkout to
# /opt/airport-recovery/secrets/backend.env, owned by root and chmod 600.
# Preserve the current installation's provider settings and limits. Never copy
# its SQLite database into an image or commit this populated file.
# Configure before installation:
# python3 backend/scripts/configure_operator.py --env-file /path/to/backend.env --username operator --generate
OPERATOR_USERNAME=
OPERATOR_PASSWORD_HASH=
# Optional literal URL-safe API bearer token (at least 32 characters if set).
OPERATOR_TOKEN=
OPENAI_API_KEY=
FR24_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
LITEAPI_API_KEY=
DUFFEL_ACCESS_TOKEN=
APL_API_KEY=
BREVO_API_KEY=
NOTIFICATION_EMAIL_FROM=
# Include other existing backend/.env settings as applicable, including model,
# environment (live/sandbox) and request/credit limits. Do not reset consumed
# usage: it lives in the restored database, not in this file.
